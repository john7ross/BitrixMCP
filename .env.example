# Copy to .env (auto-loaded by uv/most launchers) or set in the environment.

# Default incoming webhook used when a call doesn't pass its own.
# Format: https://<portal>/rest/<user_id>/<token>/
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# Block all write methods (add/update/delete/...). Reads always pass. Default: off.
# BITRIX_READ_ONLY=1

# Per-request HTTP timeout, seconds (default 60).
# BITRIX_TIMEOUT=60

# Max pages walked when a list tool is called with fetch_all=true (default 40 -> 2000 records).
# BITRIX_MAX_PAGES=40

# --- HTTP transport (only when running with --http) ---
# BITRIX_TRANSPORT=http
# BITRIX_HTTP_HOST=127.0.0.1
# BITRIX_HTTP_PORT=8000

# --- Event feed (change detection) ---
# Two independent paths; enable either, both, or neither.
# Shared SQLite file (created on first use). Holds received events and poll cursors.
# BITRIX_EVENT_DB=./bitrix_events.sqlite3
# BITRIX_EVENT_RETENTION_DAYS=14

# PUSH — outgoing-webhook receiver. Requires --http and a URL the portal can reach.
# Token from the outgoing webhook form on the portal. Without it the endpoint
# refuses every delivery with 503 (never runs unauthenticated).
# BITRIX_EVENT_TOKEN=
# BITRIX_EVENT_PATH=/b24/events

# PULL — polling fallback. Outbound requests only: works behind NAT/VPN, needs no
# inbound URL, no firewall rule. Use this when the portal cannot reach this host.
# BITRIX_POLL_FEEDS=tasks

# --- TLS (only when running with --http) ---
# The MCP SDK's own runner has no TLS options, so serving https requires these.
# Leave unset to serve plain http (fine behind a reverse proxy).
# BITRIX_HTTP_SSL_CERT=/path/to/fullchain.pem
# BITRIX_HTTP_SSL_KEY=/path/to/privkey.pem

# --- Telegram forwarding (optional) ---
# Ships captured events to a chat or channel so a human sees them without
# asking an agent. Works on both transports and with any of the three event
# sources above.
#
# Bot token from @BotFather. This is the ONE setting the agent cannot change -
# a credential belongs here, not in a chat transcript.
# BITRIX_TELEGRAM_TOKEN=

# Where to post: your numeric user id, a channel id (-100...), or @channelname.
# For a channel, add the bot as an administrator first.
# BITRIX_TELEGRAM_CHAT_ID=

# WHICH events to forward. Empty = nothing is sent. That default is deliberate:
# the pull channel is chatty (chat-read receipts and the like), and a forwarder
# that floods on first run gets muted and never trusted again. You decide what
# is worth an interruption.
#
# Syntax: comma-separated, case-insensitive.
#   tasks/*            every pull-channel task event
#   ONCRMDEAL*         every outgoing-webhook deal event
#   tasks/task_update  one exact event
#   entity:task        anything attached to a task, whatever the source
#   source:poll        anything the poller found
#   *                  everything
# A leading '-' excludes, and exclusions win:  *,-im/*  = everything but chat.
#
# Presets available through b24_telegram_configure: work, tasks, crm,
# everything, nothing.
# BITRIX_TELEGRAM_EVENTS=tasks/*,ONTASK*,ONCRM*,poll/*,-im/*

# Force on/off. Unset means: on as soon as a token and a chat id both exist.
# BITRIX_TELEGRAM_ENABLED=1
#
# Filter, chat id and the on/off switch can also be changed at runtime with
# b24_telegram_configure - those overrides live in the event database and win
# over the values here. b24_telegram_configure(reset=true) drops them, so this
# file stays the record of intent. Check the current state with
# b24_telegram_status, and preview without sending via
# b24_telegram_test(preview_only=true).
