@startuml bitrix_mcp_sequence
' Main end-to-end flow: an agent calls a typed list tool.
' Render: java -jar plantuml.jar -tpng docs/diagrams/sequence.puml

title Bitrix24 MCP - end-to-end call flow (b24_crm_list)

actor "MCP client" as C
participant "MCP transport" as T
participant "Tool (crm.py)" as TL
participant "runtime.run_list" as R
participant "BitrixClient" as B
participant "sanitize" as S
database "Bitrix24 REST" as P

C -> T : tools/call b24_crm_list {entity, filter, ...}
T -> TL : invoke (ctx injected)
TL -> R : run_list("crm.deal.list", params)
R -> R : resolve_webhook (personal > url > header > env)
R -> R : guard_write (read method -> allowed)
R -> B : call_list(method, params, start, fetch_all)
B -> P : POST /rest/<id>/<tok>/crm.deal.list.json  (JSON body)
alt success
  P --> B : {result:[...], total, next}
  B --> R : {items, count, total, next, has_more, truncated}
  R -> S : scrub (webhooks/tokens Bitrix echoes back)
  S --> R : redacted payload
  R --> TL : JSON string
else Bitrix error (e.g. ACCESS_DENIED)
  P --> B : {error, error_description}
  B --> R : raise BitrixError(code)
  R -> S : scrub
  S --> R : redacted payload
  R --> TL : JSON {error:true, code, message}
end
TL --> T : text result
T --> C : tools/call result

@enduml
